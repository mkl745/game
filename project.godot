; Engine configuration file.
config_version=5

[application]
config/name="شاگرد نمونه"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]
GameState="*res://scripts/game_state.gd"
TimeManager="*res://scripts/time_manager.gd"
RelationshipManager="*res://scripts/relationship_manager.gd"
IntelManager="*res://scripts/intel_manager.gd"
DialogueManager="*res://scripts/dialogue_manager.gd"
EventManager="*res://scripts/event_manager.gd"
SaveManager="*res://scripts/save_manager.gd"

[gui]
theme/custom="res://assets/fa_theme.tres"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[internationalization]
locale="fa"

[android]
